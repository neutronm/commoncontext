# Three roles, two strings:
#   Hyperdrive config  -> DIRECT string   (set once at `hyperdrive create` time)
#   Local tooling      -> SESSION POOLER  (this file)
#   Deployed Workers   -> neither, they get the HYPERDRIVE binding
#
# Supabase SESSION-MODE POOLER string, used by psql, migrations, seed, vitest
# and wrangler dev — everything that runs locally.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Port 5432 on the pooler host is SESSION mode; 6543 is transaction mode and
# breaks the prepared statements postgres.js relies on.
DATABASE_URL=

# Same pooler string. The MCP development command must load this value from the
# repository-root `.env.local` before starting Wrangler; Wrangler started from
# `mcp-worker/` does not discover the parent environment file on its own.
# This makes local development reach Postgres directly instead of going through
# the deployed Hyperdrive config.
# (The older WRANGLER_-prefixed name still works but is deprecated.)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Demo-lifetime bearer tokens. Must match `vars` in mcp-worker/wrangler.jsonc.
DEMO_TOKEN_FRED=
DEMO_TOKEN_SARA=
